<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ 어댑티브 런처 아이콘. 엔진 매니페스트가 가리키는 @drawable/icon을 anydpi-v26이 가로채 배경·전경 두 층으로 그린다.
     층 PNG는 Tools/GenerateAndroidIcons.ps1이 Resources/Branding/AndroidAppIcon.png에서 만든다(108dp 캔버스, 가운데 72dp가 보임). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/icon_background"/>
    <foreground android:drawable="@drawable/icon_foreground"/>
</adaptive-icon>
