    {
      "id": "text-0243",
      "type": "text",
      "x": 4787,
      "y": 2945,
      "width": 516,
      "height": 270,
      "angle": 0,
      "strokeColor": "#475569",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-05",
      "roundness": null,
      "seed": 1110155206,
      "version": 1,
      "versionNonce": 566054072,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786233600000,
      "link": null,
      "locked": false,
      "text": "A/B 슬롯을 번갈아 기록\nGeneration으로 최신본 판별\nPayloadSize · CRC32 Envelope\n\n기록 직후 같은 슬롯 재읽기\nCRC와 역직렬화 확인\nGeneration 일치 시에만 성공\n\n최신 슬롯 손상 → 직전 정상본\n양쪽 손상 → 새 데이터",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A/B 슬롯을 번갈아 기록\nGeneration으로 최신본 판별\nPayloadSize · CRC32 Envelope\n\n기록 직후 같은 슬롯 재읽기\nCRC와 역직렬화 확인\nGeneration 일치 시에만 성공\n\n최신 슬롯 손상 → 직전 정상본\n양쪽 손상 → 새 데이터",
      "autoResize": false,
      "lineHeight": 1.35
    },
